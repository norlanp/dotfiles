{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "ollama-cloud/gemma4:cloud",
  "provider": {
    "synthetic": {
      "models": {
        "syn:small:vision": {
          "name": "syn:small:vision",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 },
          "cost": { "input": 0.45, "output": 2.2, "cache_read": 0.09 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "syn:large:vision": {
          "name": "syn:large:vision",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 524288, "output": 65536 },
          "cost": { "input": 3, "output": 15, "cache_read": 0.45 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "syn:small:text": {
          "name": "syn:small:text",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 196608, "output": 65536 },
          "cost": { "input": 0.1, "output": 0.5, "cache_read": 0.02 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "syn:large:text": {
          "name": "syn:large:text",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 524288, "output": 65536 },
          "cost": { "input": 1, "output": 3, "cache_read": 0.16 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  "permission": {
    "read": {
      "~/.ssh/**": "deny",
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "edit": {
      "~/.ssh/**": "deny",
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "glob": {
      "~/.ssh/**": "deny",
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "grep": {
      "~/.ssh/**": "deny",
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "list": {
      "~/.ssh/**": "deny"
    },
    "bash": {
      "*~/.ssh*": "deny",
      "*$HOME/.ssh*": "deny",
      "ssh *": "ask"
    }
  },
  "mcp": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--browser",
          "firefox"
        ],
        "enabled": false
      },
      "trello":{
        "type": "remote",
        "url": "https://mcp.trello.com/v1",
        "enabled": false
      }
    },
  "snapshot": false
}
